@model Link

@{
    var shareUrl = Url.RouteUrl("Follow ShortUrl", new { shortUrl = Model.ShortURL }, Context.Request.Scheme);
}

Your link was created: @Html.TextBox("fullurl", shareUrl)
<br/>
<a href="@shareUrl">@shareUrl</a>

<script type="text/javascript">
    $(document).ready(function () {
        $("input:text").focus(function () { $(this).select(); });
        $('#fullurl').focus();
		$('#fullurl').select();
	});
</script>
