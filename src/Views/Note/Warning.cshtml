@model string

@{
    ViewBag.Title = "Warning";
}

<h2>Warning</h2>
<p>Once you view this note it will no longer be available. Make sure to copy or otherwise save any needed information if necessary.</p>
<form asp-controller="Note" asp-action="Display" asp-route-id="" method="post" asp-antiforgery="true">
    <input type="hidden" name="id" value="@Model" />
    <button type="submit" class="btn btn-link p-0">View Note</button>
</form>
