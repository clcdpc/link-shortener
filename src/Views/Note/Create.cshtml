@model string

@{
    ViewBag.Title = "Create";
    var shareUrl = Url.RouteUrl("View Note Warning", new { noteId = Model }, Context.Request.Scheme);
}

<h2>Note Created</h2>
<p>Your one time view note has been created and can be found at the URL below</p>
<p>This URL is not automatically shared and must be manually sent</p>
<p><strong>Your note will expire after 30 days (@DateTime.Now.AddDays(30).ToShortDateString())</strong></p>
<div>
    <span style="font-weight:bold;">Share this URL: </span>
    <input id="fullurl" type="text" value="@shareUrl" style="width:100%; max-width:40rem;" />
</div>

<script type="text/javascript">
    const input = document.getElementById('fullurl');
    input.addEventListener('focus', () => input.select());
    input.focus();
    input.select();
</script>
