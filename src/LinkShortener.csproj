<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Clc.LinkShortener</RootNamespace>
    <AssemblyName>Clc.LinkShortener</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);config/**;**/application.json;appsettings*.json;Keys/**;Logs/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <_WebToolingArtifacts Remove="Properties\PublishProfiles\dev.pubxml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Clc.Authentication" Version="1.0.1" />
    <PackageReference Include="Clc.Cloudflare.AspNetCore" Version="1.0.0" />
    <PackageReference Include="Clc.Configuration" Version="0.1.0-beta.6" />
    <PackageReference Include="Clc.Logging" Version="0.1.0-beta.2" />
    <PackageReference Include="Dapper" Version="2.0.123" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
    <PackageReference Include="Microsoft.Identity.Web.UI" Version="4.18.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="config/example.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Resources/note-words.txt" LogicalName="Clc.LinkShortener.Resources.note-words.txt" />
    <InternalsVisibleTo Include="LinkShortener.Tests" />
  </ItemGroup>

</Project>
