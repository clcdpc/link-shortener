@model Clc.LinkShortener.Data.Link
@{
	ViewBag.Title = "Home Page";
}

@Html.ValidationSummary()

<div id="content">
	@using (Html.BeginForm("CreateLink","Link"))
	{
		<div class="editor-label">
			@Html.Label("URL to shorten")
		</div>
		<div class="editor-field">
			@Html.TextBox("URL")
		</div>
         <div class="editor-label">
			@Html.Label("Desired short url, if any")
		</div>
		<div class="editor-field">
			@Html.TextBox("shortURL")
		</div>
		<br />
		<input type="submit" value="Create Short URL" />
	}

    @Html.ActionLink("Edit Links", "List", null, new { style = "font-size:72px;" })
    
    <a href="javascript:(function(){document.body.appendChild(document.createElement('script')).src='//go.clcohio.org/scripts/bookmarklet.js';})();">Shorten Link</a>
</div>
