@model Link

@{
    ViewBag.Title = "Edit";
}

<h2>Edit</h2>

@using(Html.BeginForm("Edit", "Link")){
    @Html.HiddenFor(x => x.ShortURL);
<table>
    <tr>
        <td> URL </td>
        <td> @Html.EditorFor(x => x.URL) </td>
    </tr>
    <tr>
        <td colspan="2"> <input type="submit" /></td>
    </tr>
</table>
}